# syntax=docker/dockerfile:1
# Imagen de un equipo (`torneo-bot:<equipo>`) = imagen de bots + su requirements.txt.
# Construir desde la raíz del repo:
#   docker build -f sistema/Dockerfile.equipo --build-arg EQUIPO=<carpeta> \
#       -t torneo-bot:<carpeta> .
ARG BASE=torneo-bot-base:local
FROM ${BASE}

ARG EQUIPO

# Solo se copia requirements.txt (cambiar el código no reinstala nada).
# Los corchetes son comodines: si el archivo no existe, no se copia y no falla.
# - `estudiante[s]`: sin él, BuildKit falla con «lstat ... no such file».
# - sistema/constraints.txt: ancla que siempre existe; sin ella, el builder
#   clásico (SDK de Docker, docker sin buildx) falla con «no source files».
#   No se usa: pip toma /torneo/sistema/constraints.txt de la imagen base.
COPY sistema/constraints.txt estudiante[s]/${EQUIPO}/requirements.tx[t] /tmp/equipo/

USER root

# Regla de seguridad: después de `pip install` no se ejecuta NINGÚN Python
# (un paquete del equipo podría traer un .pth que corre al iniciar Python).
# Por eso el límite se lee antes de instalar y la medición usa solo shell.
# pip NUNCA lee el requirements.txt del equipo: validador.requirements --lineas
# revisa sus bytes crudos (UTF-8 estricto, sin `coding:`, solo `paquete==versión`)
# y escribe una copia limpia (limpio.txt) que es lo único que recibe pip.
RUN set -eu; \
    if [ -z "${EQUIPO:-}" ]; then \
        echo "Falta el nombre del equipo: usa --build-arg EQUIPO=<carpeta>." >&2; exit 1; \
    fi; \
    req=/tmp/equipo/requirements.txt; \
    if [ ! -f "$req" ]; then \
        echo "El equipo ${EQUIPO} no tiene requirements.txt: se usa la imagen de bots."; \
        rm -rf /tmp/equipo; exit 0; \
    fi; \
    limpio=/tmp/equipo/limpio.txt; \
    # 0) Revisar los bytes crudos y escribir la copia limpia (solo paquete==versión).
    python -m validador.requirements --lineas "$req" --salida "$limpio"; \
    pip_equipo="--only-binary=:all: -c /torneo/sistema/constraints.txt -r $limpio"; \
    # 1) Resolver sin instalar y guardar la resolución completa.
    pip install --dry-run --quiet --report /tmp/equipo/resolucion.json $pip_equipo; \
    # 2) Auditar TODA la resolución: lista negra (nombres normalizados) y que no
    #    cambie numpy/scipy/numba/llvmlite; solo wheels.
    python -m validador.requirements /tmp/equipo/resolucion.json; \
    # 3) Datos para medir, leídos ANTES de instalar nada del equipo.
    limite="$(python -c 'import config; print(config.cargar_limites().requirements_mb)')"; \
    sitio="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    antes="$(du -sm "$sitio" | cut -f1)"; \
    # 4) Instalar (solo wheels: no se ejecuta ningún setup.py) y medir con shell.
    pip install $pip_equipo; \
    despues="$(du -sm "$sitio" | cut -f1)"; \
    usado=$((despues - antes)); \
    if [ "$usado" -gt "$limite" ]; then \
        echo "Tu requirements.txt instala ${usado} MB y el límite es ${limite} MB. Quita paquetes." >&2; \
        exit 1; \
    fi; \
    echo "requirements.txt de ${EQUIPO}: ${usado} MB instalados (límite ${limite} MB)."; \
    rm -rf /tmp/equipo

USER 65534:65534
